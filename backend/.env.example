# Copy these settings into backend/.env. Replace the secret before deployment.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_COOKIES=False
FRONTEND_BASE_URL=http://localhost:3000

# Optional PostgreSQL (for example Neon). Leave unset to use local SQLite.
# Keep the connection string in backend/.env, never in a NEXT_PUBLIC_* variable.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local development prints reset emails in the Django terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production, configure an SMTP provider instead:
# DJANGO_DEBUG=False
# DJANGO_SECURE_COOKIES=True
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=InvestGuinee <noreply@example.com>
